18. Use House_Price prediction dataset. Provide summary statistics (mean,
median, minimum, maximum, standard deviation) of variables (categorical
vs quantitative) such as- For example, if categorical variable is age groups
and quantitative variable is income, then provide summary statistics of
income grouped by the age groups.


import pandas as pd
import numpy as np
import ast
import re

# ================================================================
# 1️⃣ LOAD THE DATASET
# ================================================================
df = pd.read_csv("/mnt/data/house_price.csv")   # <-- replace with your file
print("Loaded shape:", df.shape)

# ================================================================
# 2️⃣ FIX TURKISH / INVALID TEXT CHARACTERS
# ================================================================
def fix_text(x):
    if isinstance(x, str):
        return (
            x.replace("Ä±", "ı")
            .replace("ÅŸ", "ş")
            .replace("Åž", "Ş")
            .replace("Ã§", "ç")
            .replace("Ã¼", "ü")
            .replace("Ã¶", "ö")
            .replace("ÄŸ", "ğ")
            .replace("Ã‡", "Ç")
        )
    return x

df = df.applymap(fix_text)

# ================================================================
# 3️⃣ CLEAN PRICE COLUMN (EXAMPLE: remove commas, TL, symbols)
# ================================================================
def clean_price(p):
    if isinstance(p, str):
        p = re.sub(r"[^\d]", "", p)
        return int(p) if p.isdigit() else np.nan
    return p

if "price" in df.columns:
    df["price"] = df["price"].apply(clean_price)

# ================================================================
# 4️⃣ CLEAN ANY NUMERIC COLUMNS WITH "m2" OR STR VALUES
# ================================================================
for col in df.columns:
    if df[col].dtype == object:
        # convert lists stored as strings → actual lists
        try:
            df[col] = df[col].apply(lambda x: ast.literal_eval(x) if isinstance(x, str) and x.startswith("[") else x)
        except:
            pass
        
        # convert numeric-looking strings to numbers
        df[col] = df[col].replace({",": ""}, regex=True)
        df[col] = pd.to_numeric(df[col], errors="ignore")

# ================================================================
# 5️⃣ HANDLE MISSING VALUES
# ================================================================
df = df.fillna(method="ffill").fillna(method="bfill")

# ================================================================
# 6️⃣ IDENTIFY CATEGORICAL & NUMERICAL VARIABLES
# ================================================================
categorical_cols = df.select_dtypes(include=["object", "category"]).columns.tolist()
numeric_cols = df.select_dtypes(include=["int64", "float64"]).columns.tolist()

print("\nCategorical Columns:", categorical_cols)
print("Numeric Columns:", numeric_cols)

# ================================================================
# 7️⃣ Q18 — GROUP-BY SUMMARY STATISTICS
# ================================================================
print("\n================= SUMMARY STATISTICS (Q18) =================\n")

for cat in categorical_cols:
    print(f"\n### GROUPED BY: {cat} ###\n")
    
    for num in numeric_cols:
        print(f"--- {num} grouped by {cat} ---")
        summary = df.groupby(cat)[num].agg(["mean", "median", "min", "max", "std"])
        print(summary)
        print("\n")
