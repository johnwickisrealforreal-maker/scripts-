11. Use Iris flower dataset and perform following :
1. List down the features and their types (e.g., numeric, nominal)
available in the dataset. 2. Create a histogram for each feature in the
dataset to illustrate the feature distributions.


# program11_iris_features_hist_csv.py
# Iris dataset: feature listing + histograms (using CSV file)

import pandas as pd
import matplotlib.pyplot as plt

# 1) Load the dataset from CSV file
df = pd.read_csv("iris.csv")      # <-- your uploaded file name

print("---- Iris Dataset Feature Information ----\n")

# List features and their types
print("Features and Types:")
for col in df.columns:
    if col != "species":
        print(f"  - {col} : numeric")
    else:
        print(f"  - {col} : nominal")

# List species classes
print("\nSpecies Classes:")
for cls in df["species"].unique():
    print("  -", cls)

# 2) Histograms for each numeric feature
numeric_features = df.select_dtypes(include=['float64', 'int64']).columns

print("\nHistograms will open in separate windows...")

for col in numeric_features:
    plt.figure()
    plt.hist(df[col], bins=10)
    plt.title(f"Histogram of {col}")
    plt.xlabel(col)
    plt.ylabel("Frequency")
    plt.tight_layout()
    plt.show()
