# -----------------------------------------------------------
# Q3: Statistical Analysis + Histogram for House Price Dataset
# -----------------------------------------------------------

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt



df = pd.read_csv("house_price.csv")   # <-- replace with your filename
print("\nDataset Loaded Successfully!\n")


# -------------------------------------------------------------------
# STEP 1: Clean numeric columns (Price, NetSquareMeters, GrossSquareMeters)
# because your dataset has values like "3,100,000TL" or "120 m2"
# -------------------------------------------------------------------

def clean_numeric(col):
    return (col.astype(str)
            .str.replace("TL", "", regex=False)
            .str.replace("m2", "", regex=False)
            .str.replace(",", "", regex=False)
            .str.extract(r"(\d+\.?\d*)")[0]
            .astype(float)
            )

numeric_columns = []

for col in df.columns:
    # Try converting columns that look numeric after cleaning
    try:
        cleaned = clean_numeric(df[col])
        if cleaned.notna().sum() > 0:   # at least some numeric values found
            df[col] = cleaned
            numeric_columns.append(col)
    except:
        pass

print("Detected Numeric Columns:", numeric_columns)
print("----------------------------------------------------\n")


# -------------------------------------------------------------------
# STEP 2: Handle Missing Values
# -------------------------------------------------------------------
df[numeric_columns] = df[numeric_columns].fillna(df[numeric_columns].mean())
print("Missing numeric values filled with column mean.\n")


# -------------------------------------------------------------------
# STEP 3: Compute Standard Deviation, Variance, Percentiles
# -------------------------------------------------------------------
print("📌 STANDARD DEVIATION (Feature-wise):")
print(df[numeric_columns].std())
print("\n----------------------------------------------------")

print("📌 VARIANCE (Feature-wise):")
print(df[numeric_columns].var())
print("\n----------------------------------------------------")

print("📌 PERCENTILES (25%, 50%, 75%):")
percentiles = df[numeric_columns].describe(percentiles=[0.25, 0.5, 0.75]).T[['25%', '50%', '75%']]
print(percentiles)
print("\n----------------------------------------------------")


# -------------------------------------------------------------------
# STEP 4: Histogram for each numerical feature
# -------------------------------------------------------------------
print("Generating Histograms for all Numerical Features...")

df[numeric_columns].hist(
    figsize=(12, 10),
    bins=12,
    edgecolor='black'
)

plt.suptitle("Feature Distribution Histograms", fontsize=16)
plt.tight_layout()
plt.show()
