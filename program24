24. Perform the following operations using Python on a suitable data set,
counting unique values of data, format of each column, converting variable
data type (e.g. from long to short, vice versa), identifying missing values
and filling in the missing values.

import pandas as pd
import numpy as np

# ----------------------------------------------------------------
# 1. Create a suitable mock dataset (Categorical + Quantitative)
# ----------------------------------------------------------------
# Dataset includes:
# - AgeGroup (categorical)
# - City (categorical)
# - Income (quantitative)
# - HousePrice (quantitative)
# - Rooms (quantitative, but stored as string to convert later)

data = {
    "AgeGroup": ["20-30", "30-40", "20-30", np.nan, "40-50", "30-40"],
    "City": ["Mumbai", "Delhi", "Delhi", "Pune", "Mumbai", None],
    "Income": [55000, 72000, 61000, np.nan, 90000, 90000],
    "HousePrice": [75.5, 120.0, 95.0, 110.0, np.nan, 130.0],
    "Rooms": ["2", "3", "3", None, "4", "4"],  # stored as strings intentionally
}

df = pd.DataFrame(data)

print("\nOriginal Dataset:\n")
print(df)

# ----------------------------------------------------------------
# 2. Count unique values
# ----------------------------------------------------------------
print("\nUnique Value Counts:\n")
print(df.nunique())

# ----------------------------------------------------------------
# 3. Check column formats (dtypes)
# ----------------------------------------------------------------
print("\nColumn Data Types Before Conversion:\n")
print(df.dtypes)

# ----------------------------------------------------------------
# 4. Convert variable data types
# ----------------------------------------------------------------

# Convert Rooms from string → integer
df["Rooms"] = pd.to_numeric(df["Rooms"], errors="coerce")

# Convert AgeGroup to category type
df["AgeGroup"] = df["AgeGroup"].astype("category")

# Convert City to category type
df["City"] = df["City"].astype("category")

# Downcast numeric values for optimization
df["Income"] = pd.to_numeric(df["Income"], downcast="integer")
df["HousePrice"] = pd.to_numeric(df["HousePrice"], downcast="float")

print("\nColumn Data Types After Conversion:\n")
print(df.dtypes)

# ----------------------------------------------------------------
# 5. Identify missing values
# ----------------------------------------------------------------
print("\nMissing Values in Dataset:\n")
print(df.isnull().sum())

# ----------------------------------------------------------------
# 6. Fill Missing Values
# ----------------------------------------------------------------

# Fill numeric columns with mean
df["Income"] = df["Income"].fillna(df["Income"].mean())
df["HousePrice"] = df["HousePrice"].fillna(df["HousePrice"].mean())
df["Rooms"] = df["Rooms"].fillna(df["Rooms"].median())

# Fill categorical columns with mode
df["AgeGroup"] = df["AgeGroup"].fillna(df["AgeGroup"].mode()[0])
df["City"] = df["City"].fillna(df["City"].mode()[0])

print("\nFinal Dataset After Handling Missing Values:\n")
print(df)
