12.Use Iris flower dataset and perform following :
1. Create a box plot for each feature in the dataset.
2. Identify and discuss distributions and identify outliers from them.


# program12_iris_boxplot_csv.py
# Iris dataset: boxplots + distribution and outlier analysis (using CSV file)

import pandas as pd
import matplotlib.pyplot as plt

# 1) Load dataset from CSV
df = pd.read_csv("iris.csv")   # <-- use your file name

# Identify numeric features
numeric_cols = df.select_dtypes(include=['float64', 'int64']).columns

# 1) Create boxplot for each numeric feature
for col in numeric_cols:
    plt.figure()
    plt.boxplot(df[col])
    plt.title(f"Box Plot of {col}")
    plt.ylabel(col)
    plt.tight_layout()
    plt.show()

# 2) Distribution & outlier analysis
print("\n---- Distribution & Outlier Analysis ----\n")

for col in numeric_cols:
    print(f"{col}:")
    q1 = df[col].quantile(0.25)
    q3 = df[col].quantile(0.75)
    iqr = q3 - q1
    lower = q1 - 1.5 * iqr
    upper = q3 - 1.5 * iqr

    # Count outliers
    outliers = df[(df[col] < lower) | (df[col] > upper)][col]

    # Basic distribution comment
    if df[col].skew() == 0:
        dist = "symmetrical distribution"
    elif df[col].skew() > 0:
        dist = "right-skewed distribution"
    else:
        dist = "left-skewed distribution"

    print(f"  - Distribution: {dist}")
    print(f"  - IQR: {iqr:.3f}")
    print(f"  - Outlier range: < {lower:.2f} or > {upper:.2f}")

    if outliers.empty:
        print("  - Outliers: No significant outliers detected.\n")
    else:
        print(f"  - Outliers detected: {list(outliers.values)}\n")
