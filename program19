19. Write a Python program to display some basic statistical details like
percentile, mean, standard deviation etc (Use python and pandas
commands) the species of ‘Iris-setosa’, ‘Iris-versicolor’ and ‘Iris-versicolor’
of iris.csv dataset.

import pandas as pd

# ===============================
# 1) Load the iris.csv file
# ===============================
df = pd.read_csv("iris.csv")   # <-- your uploaded file

# Ensure column names match common iris formats
df.columns = df.columns.str.strip().str.lower()

# ===============================
# 2) Function to display statistics
# ===============================
def show_stats(species_name):
    print(f"\n===================== {species_name} =====================\n")
    
    subset = df[df["species"] == species_name]

    # Basic descriptive statistics
    print("------ describe() ------")
    print(subset.describe(), "\n")
    
    # Mean
    print("------ Mean ------")
    print(subset.mean(numeric_only=True), "\n")

    # Standard deviation
    print("------ Standard Deviation ------")
    print(subset.std(numeric_only=True), "\n")

    # Percentiles
    print("------ Percentiles (25%, 50%, 75%) ------")
    print(subset.quantile([0.25, 0.50, 0.75]), "\n")

    # Variance
    print("------ Variance ------")
    print(subset.var(numeric_only=True), "\n")

    # Minimum values
    print("------ Minimum Values ------")
    print(subset.min(numeric_only=True), "\n")

    # Maximum values
    print("------ Maximum Values ------")
    print(subset.max(numeric_only=True), "\n")


# ===============================
# 3) Print statistics for all 3 species
# ===============================
show_stats("Iris-setosa")
show_stats("Iris-versicolor")
show_stats("Iris-virginica")
