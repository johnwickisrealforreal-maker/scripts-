# ---- Reconstructed dataset from image (for demo) -----
data = {
    "Age": ["Young","Young","Middle","Old","Old","Old","Middle","Young",
            "Young","Old","Young","Middle","Middle","Old"],
    "Income": ["High","High","High","Medium","Low","Low","Low","Medium",
               "Low","Medium","Medium","Medium","High","Medium"],
    "Married": ["No","No","No","No","Yes","Yes","Yes","No",
                "Yes","No","Yes","No","Yes","No"],
    "Health": ["Fair","Good","Fair","Fair","Fair","Good","Good","Fair",
               "Fair","Fair","Good","Good","Fair","Good"],
    "Class": ["No","No","Yes","Yes","Yes","No","Yes","No",
              "Yes","Yes","Yes","Yes","Yes","No"]
}
df = pd.DataFrame(data)

# Normalize age (Young/young)
df["Age"] = df["Age"].str.capitalize()

print("===== Dataset Loaded =====")
print(df, "\n")

# ======================================================
# 2. FREQUENCY TABLE FOR AGE
# ======================================================
freq_table = df["Age"].value_counts()
print("===== FREQUENCY TABLE FOR AGE =====")
print(freq_table, "\n")

# ======================================================
# 3. ENTROPY FUNCTION
# ======================================================
def entropy(col):
    counts = col.value_counts()
    total = len(col)
    ent = 0
    for c in counts:
        p = c / total
        ent += -p * log2(p)
    return ent

# ======================================================
# 4. ENTROPY OF THE TOTAL DATASET (Target = Class)
# ======================================================
entropy_total = entropy(df["Class"])
print("Entropy of Entire Dataset = ", round(entropy_total, 4), "\n")

# ======================================================
# 5. ENTROPY OF SPLITS BASED ON AGE
# ======================================================
weighted_entropy = 0

print("===== ENTROPY FOR EACH AGE GROUP =====")
for age_group, subset in df.groupby("Age"):
    e = entropy(subset["Class"])
    weight = len(subset) / len(df)
    weighted_entropy += weight * e
    print(f"Age = {age_group:6s}  | Count = {len(subset):2d} | Entropy = {round(e,4)}")

print("\nWeighted Entropy =", round(weighted_entropy, 4))

# ======================================================
# 6. INFORMATION GAIN
# ======================================================
IG = entropy_total - weighted_entropy
print("\n===== INFORMATION GAIN WHEN SPLITTING ON 'AGE' =====")
print("Information Gain =", round(IG, 4))
