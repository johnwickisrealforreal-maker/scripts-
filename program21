21. Write a program to cluster a set of points using K-means for IRIS
dataset. Consider, K=4, clusters. Consider Euclidean distance as the
distance measure. Randomly initialize a cluster mean as one of the data
points. Iterate at least for 10 iterations. After iterations are over, print the
final cluster means for each of the clusters.

# program21_iris_kmeans_manual.py
# Manual K-Means for Iris dataset (K = 4), 10 iterations, Euclidean distance

import random
import math
import numpy as np
from sklearn.datasets import load_iris

# reproducible randomness
RNG_SEED = 42
random.seed(RNG_SEED)
np.random.seed(RNG_SEED)

# Load Iris dataset
iris = load_iris()
X = iris.data            # shape (150, 4)
n_samples, n_features = X.shape

K = 4                    # **** K = 4 as question asks ****
n_iters = 10

def euclidean(a, b):
    return np.linalg.norm(a - b, axis=1)

# ==============================
# Step 1: Random initialization
# ==============================
initial_idx = np.random.choice(n_samples, size=K, replace=False)
centroids = X[initial_idx].astype(float)

print("Initial centroids (random data points):")
for i, c in enumerate(centroids, 1):
    print(f"  m{i} = {np.round(c, 4)}")
print()

# ==============================
# K-Means Main Loop
# ==============================
for it in range(1, n_iters + 1):

    # Step 2: Assign clusters based on distance
    distances = np.zeros((n_samples, K))
    for k in range(K):
        distances[:, k] = euclidean(X, centroids[k])

    labels = np.argmin(distances, axis=1)  # cluster assignment vector

    # Step 3: Compute SSE for diagnostics
    sse = 0.0
    for k in range(K):
        pts = X[labels == k]
        if pts.size > 0:
            sse += np.sum((pts - centroids[k])**2)

    # Step 4: Recompute centroids
    new_centroids = np.zeros_like(centroids)
    for k in range(K):
        assigned = X[labels == k]
        if assigned.shape[0] == 0:
            # empty cluster → reinitialize to random point
            ridx = np.random.choice(n_samples)
            new_centroids[k] = X[ridx]
            print(f"Iteration {it}: Cluster {k+1} empty → reinitialized to point {ridx}")
        else:
            new_centroids[k] = np.mean(assigned, axis=0)

    # ========== Print iteration results ==========
    print(f"Iteration {it} summary:")
    for k in range(K):
        size = np.sum(labels == k)
        print(f"  Cluster {k+1}: size = {size}, centroid = {np.round(new_centroids[k], 4)}")
    print(f"  SSE = {sse:.4f}\n")

    centroids = new_centroids


# ==============================
# Final Output
# ==============================
print("\nFinal cluster means after 10 iterations:")
for k in range(K):
    print(f"  m{k+1} = {np.round(centroids[k], 6)}")

# also print cluster sizes
final_labels = np.argmin(np.array([euclidean(X, centroids[k]) for k in range(K)]).T, axis=1)

print("\nFinal cluster sizes:")
for k in range(K):
    print(f"  Cluster {k+1}: {np.sum(final_labels == k)} points")
