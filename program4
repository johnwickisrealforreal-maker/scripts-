4. Write a program to do: A dataset collected in a cosmetics shop showing
details of customers and whether or not they responded to a special offer
to buy a new lip-stick is shown in table below. (Implement step by step
using commands - Dont use library) Use this dataset to build a decision
tree, with Buys as the target variable, to help in buying lipsticks in the
future. Find the root node of the decision tree.

import pandas as pd

# ============================================================
# 1. READ CSV (UPLOAD YOUR FILE IN EXAM)
# ============================================================

df = pd.read_csv("lipstick.csv")   # <-- Replace with your filename
print("\n===== DATASET LOADED FROM CSV =====")
print(df)

# ============================================================
# 2. GINI FUNCTION
# ============================================================

def gini(series):
    total = len(series)
    probs = series.value_counts() / total
    return 1 - sum(p**2 for p in probs)

# ============================================================
# 3. COMPUTE WEIGHTED GINI FOR EACH ATTRIBUTE
# ============================================================

def gini_for_attribute(df, attribute, target='Buys'):
    print(f"\n\n=== Calculating Gini for Attribute: {attribute} ===")
    
    total_len = len(df)
    weighted_gini = 0
    
    for value in df[attribute].unique():
        subset = df[df[attribute] == value]
        weight = len(subset) / total_len
        subset_gini = gini(subset[target])
        
        weighted_gini += weight * subset_gini
        
        print(f"  {attribute} = {value:7s} | subset size = {len(subset):2d}, "
              f"Gini = {subset_gini:.4f}, Weight = {weight:.3f}, "
              f"Weighted Part = {weight * subset_gini:.4f}")
        
    return weighted_gini

# ============================================================
# 4. BASE GINI OF TARGET COLUMN "Buys"
# ============================================================

print("\n===== BASE GINI OF TARGET (Buys) =====")
base_gini = gini(df['Buys'])
print(f"Base Gini = {base_gini:.4f}")

# ============================================================
# 5. GINI GAIN FOR ALL FEATURES
# ============================================================

attributes = [col for col in df.columns if col not in ["Id", "Buys"]]
gini_gains = {}

for attr in attributes:
    wg = gini_for_attribute(df, attr)
    gain = base_gini - wg
    gini_gains[attr] = gain
    print(f"=> Gini Gain for {attr:7s} = {gain:.4f}")

# ============================================================
# 6. ROOT NODE (ATTRIBUTE WITH HIGHEST GINI GAIN)
# ============================================================

print("\n===== GINI GAINS SUMMARY =====")
for a, g in gini_gains.items():
    print(f"{a:10s} : {g:.4f}")

root = max(gini_gains, key=gini_gains.get)
print(f"\n>>> ROOT NODE OF DECISION TREE = '{root}' (Highest Gini Gain)")
