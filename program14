# program14_covid_vaccine_genderwise.py
# COVID vaccine analytics: describe + male/female vaccination totals

import pandas as pd

# --------- Load dataset ----------
df = pd.read_csv("covid_vaccine_statewise.csv")   # upload CSV and keep same name

# --------- (A) Describe the dataset ----------
print("\n---- (A) DATASET DESCRIPTION ----\n")

print("Columns Present:")
print(df.columns.tolist(), "\n")

print("\nStatistical Summary (Numerical Columns):\n")
print(df.describe(), "\n")

print("\nDataset Info:\n")
print(df.info(), "\n")


# --------- Detect Male and Female vaccination columns ----------
male_col = None
female_col = None

for col in df.columns:
    cname = col.lower()
    if "male" in cname:
        male_col = col
    if "female" in cname:
        female_col = col

if male_col is None:
    raise ValueError("❌ Male vaccination column not found. Check CSV column names.")
if female_col is None:
    raise ValueError("❌ Female vaccination column not found. Check CSV column names.")


# --------- (B) Total number of males vaccinated ----------
print("\n---- (B) TOTAL NUMBER OF MALES VACCINATED ----\n")

total_males = df[male_col].sum()   # cumulative across rows
print(f"Total Males Vaccinated: {total_males}\n")


# --------- (C) Total number of females vaccinated ----------
print("\n---- (C) TOTAL NUMBER OF FEMALES VACCINATED ----\n")

total_females = df[female_col].sum()   # cumulative across rows
print(f"Total Females Vaccinated: {total_females}\n")
