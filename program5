5. Write a program to do: A dataset collected in a cosmetics shop showing
details of customers and whether or not they responded to a special offer
to buy a new lip-stick is shown in table below. (Use library commands)
According to the decision tree you have made from the previous training
data set, what is the decision for the test data: [Age < 21, Income = Low,
Gender = Female, Marital Status = Married]?

import pandas as pd
from sklearn.preprocessing import LabelEncoder
from sklearn.tree import DecisionTreeClassifier, export_text

# =========================================================
# 1. LOAD CSV (Upload your lipstick dataset in exam)
# =========================================================
df = pd.read_csv("lipstick.csv")   # <-- your filename
print("\n----- DATASET LOADED -----")
print(df)

# =========================================================
# 2. LABEL ENCODING FOR CATEGORICAL VARIABLES
# =========================================================
le = LabelEncoder()
encoders = {}   # store encoders for each column

for col in df.columns:
    if df[col].dtype == 'object':
        encoders[col] = LabelEncoder()
        df[col] = encoders[col].fit_transform(df[col])

# Splitting features and target
X = df[['Age', 'Income', 'Gender', 'Ms']]
y = df['Buys']

# =========================================================
# 3. TRAIN DECISION TREE USING ENTROPY
# =========================================================
model = DecisionTreeClassifier(criterion='entropy', random_state=0)
model.fit(X, y)

# =========================================================
# 4. PRINT DECISION TREE RULES
# =========================================================
print("\n----- DECISION TREE RULES -----")
print(export_text(model, feature_names=list(X.columns)))

# =========================================================
# 5. PREDICT FOR TEST INPUT
# =========================================================
test = pd.DataFrame([['<21', 'Low', 'Female', 'Married']],
                    columns=['Age', 'Income', 'Gender', 'Ms'])

# Encode test data using same encoders
for col in test.columns:
    test[col] = encoders[col].transform(test[col])

# Predict
pred = model.predict(test)[0]

print("\n----- TEST CASE PREDICTION -----")
print("Input → Age=<21, Income=Low, Gender=Female, MaritalStatus=Married")
print("Decision (Buys?):", "Yes" if pred == encoders['Buys'].transform(['Yes'])[0] else "No")
