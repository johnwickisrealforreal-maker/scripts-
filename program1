Question - 1. Perform the following operations using Python on a data set : read data
from different formats(like csv, xls),indexing and selecting data, sort data,
describe attributes of data, checking data types of each column. (Use
Titanic Dataset).



# TITANIC PRACTICAL – ALL REQUIRED OPERATIONS + EXTRA INBUILT FUNCTIONS
import pandas as pd

# ---------------- OPTION A: INBUILT SEABORN DATASET (COMMENTED OUT) -------------
# import seaborn as sns
# df = sns.load_dataset("titanic")
# ------------------------------------------------------------------------------

# ---------------- OPTION B: MANUAL CSV UPLOAD (MAIN) ---------------------------
df = pd.read_csv("titanic_real.csv")   # << replace with your file name
# ------------------------------------------------------------------------------

print("\n============= FIRST 5 ROWS =============")
print(df.head())

print("\n============= LAST 5 ROWS (extra) =============")
print(df.tail())

print("\n============= SHAPE OF DATA (rows, columns) =============")
print(df.shape)

print("\n============= COLUMN NAMES (extra) =============")
print(df.columns.tolist())

print("\n============= BASIC INFO (dtype + memory) =============")
df.info()

print("\n============= CHECK MISSING VALUES (extra) =============")
print(df.isnull().sum())

print("\n============= DESCRIBE NUMERIC ATTRIBUTES =============")
print(df.describe())

print("\n============= DESCRIBE CATEGORICAL ATTRIBUTES (extra) =============")
print(df.describe(include='object'))

print("\n============= DATA TYPES OF EACH COLUMN =============")
print(df.dtypes)

# ------------------- INDEXING & SELECTION -------------------

print("\n============= SELECTING COLUMNS (loc example) =============")
print(df.loc[:, ["Survived", "Age", "Sex"]])

print("\n============= SELECTING ROW RANGE (iloc) =============")
print(df.iloc[0:10])

print("\n============= SELECTING PASSENGERS AGE > 60 =============")
print(df.loc[df['Age'] > 60, ["Survived", "Age", "Sex"]])

print("\n============= SELECTING SPECIFIC CELL (extra) =============")
print(df.at[0, "Age"])   # single value
print(df.iat[0, 5])      # same by integer index

# ------------------- SORTING -------------------

print("\n============= SORT BY AGE (ascending) =============")
print(df.sort_values(by="Age"))

print("\n============= SORT BY FARE (descending, extra) =============")
print(df.sort_values(by="Fare", ascending=False))

print("\n============= SORT BY MULTIPLE COLUMNS (extra) =============")
print(df.sort_values(by=["Pclass", "Fare"], ascending=[True, False]))

# ------------------- MORE INBUILT FUNCTIONS (BONUS) -------------------

print("\n============= UNIQUE VALUES IN 'Sex' (extra) =============")
print(df["Sex"].unique())

print("\n============= VALUE COUNTS OF 'Pclass' (extra) =============")
print(df["Pclass"].value_counts())

print("\n============= CHECK INDEX (extra) =============")
print(df.index)

print("\n============= SAMPLE RANDOM ROWS (extra) =============")
print(df.sample(5))

print("\n============= CORRELATION MATRIX (extra) =============")
print(df.corr(numeric_only=True))

