analytics.
a. Describe the dataset
b. Number of persons state wise vaccinated for first dose in India
c. Number of persons state wise vaccinated for second dose in India

# program13_covid_vaccine_analysis.py
# COVID vaccine analytics: describe + state-wise dose counts

import pandas as pd

# --------- Load dataset ----------
# Just upload the file in your environment and give its name below
df = pd.read_csv("covid_vaccine_statewise.csv")

# --------- (a) Describe the dataset ----------
print("\n---- (a) DATASET DESCRIPTION ----\n")

print("Columns Present:")
print(df.columns.tolist(), "\n")

print("\nStatistical Summary (Numerical Columns):\n")
print(df.describe(), "\n")

print("\nDataset Info:\n")
print(df.info(), "\n")


# --------- Detect correct column names automatically ----------
def find_column(keyword):
    """Finds the first column containing a keyword."""
    for col in df.columns:
        if keyword.lower() in col.lower():
            return col
    return None

first_dose_col = find_column("First Dose")
second_dose_col = find_column("Second Dose")

if first_dose_col is None or second_dose_col is None:
    raise ValueError("Dose columns not found. Check CSV column names.")


# --------- (b) State-wise FIRST DOSE vaccinations ----------
print("\n---- (b) STATE-WISE FIRST DOSE ----\n")

# We take max() because the dataset is cumulative day-wise
first_dose_statewise = df.groupby("State")[first_dose_col].max().sort_values(ascending=False)

print(first_dose_statewise, "\n")


# --------- (c) State-wise SECOND DOSE vaccinations ----------
print("\n---- (c) STATE-WISE SECOND DOSE ----\n")

second_dose_statewise = df.groupby("State")[second_dose_col].max().sort_values(ascending=False)

print(second_dose_statewise, "\n")
