20. Write a program to cluster a set of points using K-means for IRIS
dataset. Consider, K=3, clusters. Consider Euclidean distance as the
distance measure. Randomly initialize a cluster mean as one of the data
points. Iterate at least for 10 iterations. After iterations are over, print the
final cluster means for each of the clusters.

# program20_iris_manual_kmeans.py
# Manual K-Means implementation for IRIS dataset
# K = 3 clusters, Euclidean distance, 10 iterations
# No sklearn KMeans used.

import numpy as np
import random
from sklearn.datasets import load_iris

# Reproducibility
RNG_SEED = 42
random.seed(RNG_SEED)
np.random.seed(RNG_SEED)

# Load dataset
iris = load_iris()
X = iris.data                     # Only features (150 × 4)
n_samples, n_features = X.shape

K = 3
ITERATIONS = 10

# ---------------------------------------------------------
# Euclidean distance between all points and one centroid
# ---------------------------------------------------------
def euclidean_distance(points, centroid):
    return np.linalg.norm(points - centroid, axis=1)

# ---------------------------------------------------------
# Step 1: Random initialization of centroids
# ---------------------------------------------------------
initial_indices = np.random.choice(n_samples, size=K, replace=False)
centroids = X[initial_indices].astype(float)

print("Initial Centroids:")
for i, c in enumerate(centroids, 1):
    print(f"  m{i} = {np.round(c, 4)}")
print()

# ---------------------------------------------------------
# K-Means Iterations
# ---------------------------------------------------------
for it in range(1, ITERATIONS + 1):

    # Step 2: Assign points to nearest centroid
    distance_matrix = np.zeros((n_samples, K))

    for k in range(K):
        distance_matrix[:, k] = euclidean_distance(X, centroids[k])

    labels = np.argmin(distance_matrix, axis=1)

    # Step 3: Recompute centroids
    new_centroids = np.zeros_like(centroids)

    for k in range(K):
        cluster_points = X[labels == k]

        if cluster_points.size == 0:
            # Empty cluster — reinitialize randomly
            rand_idx = np.random.choice(n_samples)
            new_centroids[k] = X[rand_idx]
            print(f"Iteration {it}: Cluster {k+1} was empty → Reinitialized to sample {rand_idx}")
        else:
            new_centroids[k] = np.mean(cluster_points, axis=0)

    print(f"Iteration {it} Summary:")
    for k in range(K):
        print(f"  Cluster {k+1}: size = {np.sum(labels == k)}, new centroid = {np.round(new_centroids[k], 4)}")
    print()

    centroids = new_centroids

# ---------------------------------------------------------
# Final Output
# ---------------------------------------------------------
print("Final Cluster Means after 10 iterations:")
for k in range(K):
    print(f"  m{k+1} = {np.round(centroids[k], 6)}")
